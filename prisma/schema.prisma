datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SUPPORT_AGENT
  STORE_ADMIN
  SUPER_ADMIN
}

enum PaymentMethod {
  PREPAID_UPI
  PREPAID_CARD
  PREPAID_NB
  COD
  GIFT_CARD
  STORE_CREDIT
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED_PAYMENT_EXPIRED
  CANCELLED_BY_USER
  CANCELLED_BY_ADMIN
  RTO_INITIATED
  RTO_RETURNED
  COMPLETED
  UNDER_WARRANTY_REVIEW
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum ShipmentStatus {
  LABEL_CREATED
  MANIFESTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RTO
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED
}

enum WarrantyClaimStatus {
  PENDING_REVIEW
  APPROVED_REPLACEMENT
  APPROVED_STORE_CREDIT
  REJECTED
}

enum CouponDiscountType {
  FLAT_AMOUNT
  PERCENTAGE
}

enum NotificationChannel {
  IN_APP
  WHATSAPP
  SMS
  EMAIL
}

enum TicketCategory {
  ORDER_RELATED
  NON_ORDER_RELATED
  WARRANTY_DOA
  BILLING_PRIVACY
  GENERAL_INQUIRY
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

// -------------------------------------------------------------
// 1. Identity & RBAC
// -------------------------------------------------------------

model User {
  id                 String               @id @default(uuid())
  phoneEncrypted     String?              @unique
  phoneHash          String?              @unique // Blind index for lookups
  email              String?              @unique
  dateOfBirth        DateTime?
  role               Role                 @default(CUSTOMER)
  isAgeVerified      Boolean              @default(false)
  isTwoFactorEnabled Boolean              @default(false)
  twoFactorSecret    String?              // Encrypted TOTP secret
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  addresses          Address[]
  orders             Order[]
  warrantyClaims     WarrantyClaim[]      @relation("CustomerClaims")
  reviewedClaims     WarrantyClaim[]      @relation("AdminReviews")
  storeCredits       StoreCreditVoucher[]
  giftCardsPurchased GiftCard[]
  backupCodes        UserBackupCode[]
  savedPaymentMethods SavedPaymentMethod[]
  notifications      Notification[]
  tickets            SupportTicket[]
  auditLogsTriggered StaffAuditLog[]      @relation("StaffAudits")

  @@index([role])
}

model UserBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullNameEncrypted    String
  addressLine1Encrypted String
  addressLine2Encrypted String?
  city                 String
  state                String
  postalCode           String   // 6-digit Indian PIN
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orders               Order[]

  @@index([userId])
  @@index([postalCode])
}

// -------------------------------------------------------------
// 2. Catalog & Medical Badges
// -------------------------------------------------------------

model Category {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime   @default(now())

  products    Product[]
}

model Product {
  id                 String               @id @default(uuid())
  slug               String               @unique
  title              String
  brand              String
  description        String
  materialType       String               // e.g., "Medical Grade Silicone / ABS"
  isPhthalateFree    Boolean              @default(true)
  isWaterproof       Boolean              @default(false)
  noiseLevelDb       Int                  @default(45) // Noise rating in decibels
  specs              Json?                // Battery, motor levels, charging specs
  isActive           Boolean              @default(true)
  
  // Dynamic & Manual Ranking / Categorization Fields
  customRankWeight   Int                  @default(0) // Higher number = higher priority
  isManualBestSeller Boolean              @default(false)
  isManualNewArrival Boolean              @default(false)
  customBadgeLabel   String?              // e.g. "Editor's Pick", "Trending"
  
  categoryId         String
  category           Category             @relation(fields: [categoryId], references: [id])
  variants           ProductVariant[]
  badges             ProductBadge[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([customRankWeight])
}

model MedicalSafetyBadge {
  id          String         @id @default(uuid())
  code        String         @unique // "SILICONE_SAFE", "WATERPROOF_IPX7", etc.
  name        String
  description String
  iconUrl     String?

  products    ProductBadge[]
}

model ProductBadge {
  productId String
  badgeId   String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  badge     MedicalSafetyBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([productId, badgeId])
}

model ProductVariant {
  id                  String             @id @default(uuid())
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                 String             @unique
  color               String?
  pricePaise          Int                // Price in Paise (INR)
  compareAtPricePaise Int?               // Original MRP in Paise
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  inventoryItem       InventoryItem?
  stockReservations   StockReservation[]
  orderItems          OrderItem[]
  warrantyClaims      WarrantyClaim[]

  @@index([productId])
  @@index([sku])
}

// -------------------------------------------------------------
// 3. Inventory & 30-Minute Hold Engine
// -------------------------------------------------------------

model InventoryItem {
  id                 String         @id @default(uuid())
  variantId          String         @unique
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  availableStock     Int            @default(0)
  reservedStock      Int            @default(0)
  lowStockThreshold  Int            @default(5)
  version            Int            @default(0) // Optimistic concurrency lock
  updatedAt          DateTime       @updatedAt
}

model StockReservation {
  id         String            @id @default(uuid())
  orderId    String
  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int
  expiresAt  DateTime          // Now + 30 Minutes
  status     ReservationStatus @default(ACTIVE)
  createdAt  DateTime          @default(now())

  @@index([orderId])
  @@index([variantId])
  @@index([status, expiresAt])
}

// -------------------------------------------------------------
// 4. Orders, Transactions & OMS
// -------------------------------------------------------------

model Order {
  id                     String               @id @default(uuid())
  orderNumber            String               @unique // e.g. "AURA-20261110-8812"
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id])
  shippingAddressId      String
  shippingAddress        Address              @relation(fields: [shippingAddressId], references: [id])
  subtotalPaise          Int
  discountPaise          Int                  @default(0)
  codFeePaise            Int                  @default(0) // ₹50 = 5000 paise
  giftCardDeductionPaise Int                  @default(0)
  storeCreditDeductionPaise Int               @default(0)
  totalAmountPaise       Int
  paymentMethod          PaymentMethod
  status                 OrderStatus          @default(PENDING_PAYMENT)
  isOtpVerified          Boolean              @default(false)
  notes                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  orderItems             OrderItem[]
  stockReservations      StockReservation[]
  paymentTransactions    PaymentTransaction[]
  shipment               Shipment?
  warrantyClaims         WarrantyClaim[]
  tickets                SupportTicket[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                   String         @id @default(uuid())
  orderId              String
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId            String
  variant              ProductVariant @relation(fields: [variantId], references: [id])
  productTitleSnapshot String         // Immutable title snapshot
  unitPricePaise       Int
  quantity             Int

  @@index([orderId])
}

model PaymentTransaction {
  id                   String        @id @default(uuid())
  orderId              String
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gatewayName          String        // "CASHFREE", "PHONEPE", "INTERNAL_CREDIT"
  gatewayTransactionId String?       @unique
  billingDescriptor    String        @default("Aura Retail & Lifestyle") // BR-06
  amountPaise          Int
  status               PaymentStatus @default(INITIATED)
  gatewayResponse      Json?
  createdAt            DateTime      @default(now())

  @@index([orderId])
  @@index([gatewayTransactionId])
}

// -------------------------------------------------------------
// 5. Logistics & Neutral Fulfillment
// -------------------------------------------------------------

model Shipment {
  id                  String               @id @default(uuid())
  orderId             String               @unique
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  awbNumber           String?              @unique
  courierPartner      String?              // "DELHIVERY", "SHIPROCKET"
  senderDeclaredName  String               @default("Aura Retail & Lifestyle") // BR-08
  packageDescription  String               @default("Personal Grooming & Wellness Kits")
  status              ShipmentStatus       @default(LABEL_CREATED)
  dispatchedAt        DateTime?
  deliveredAt         DateTime?            // Marks start of 24-hr DOA Claim window
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  webhookLogs         CourierWebhookLog[]

  @@index([awbNumber])
  @@index([status])
}

model CourierWebhookLog {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  awbNumber  String
  event      String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([shipmentId])
  @@index([awbNumber])
}

// -------------------------------------------------------------
// 6. Warranty, DOA Claims & Store Credit
// -------------------------------------------------------------

model WarrantyClaim {
  id                String              @id @default(uuid())
  claimNumber       String              @unique // e.g. "CLAIM-20261110-101"
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id])
  userId            String
  user              User                @relation("CustomerClaims", fields: [userId], references: [id])
  variantId         String
  variant           ProductVariant      @relation(fields: [variantId], references: [id])
  videoStorageUri   String              // Cloudflare R2 / S3 pre-signed URI
  defectDescription String
  status            WarrantyClaimStatus @default(PENDING_REVIEW)
  adminReviewNotes  String?
  reviewedByUserId  String?
  reviewedByUser    User?               @relation("AdminReviews", fields: [reviewedByUserId], references: [id])
  submittedAt       DateTime            @default(now()) // Must be <= deliveredAt + 24 hrs
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  storeCredit       StoreCreditVoucher?

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model StoreCreditVoucher {
  id           String        @id @default(uuid())
  voucherCode  String        @unique // "AURA-VOUCH-XXXX"
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimId      String?       @unique
  claim        WarrantyClaim? @relation(fields: [claimId], references: [id])
  balancePaise Int
  expiresAt    DateTime      // Now + 365 Days
  isRedeemed   Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([voucherCode])
}

// -------------------------------------------------------------
// 7. Subsystems: Gift Cards, Coupons, Notifications, Help Center
// -------------------------------------------------------------

model GiftCard {
  id             String    @id @default(uuid())
  codeHash       String    @unique
  maskedCode     String    // e.g. "AURA-GIFT-****-8812"
  pinHash        String    // Bcrypt hash of 4-digit PIN
  initialPaise   Int       // Initial face value in paise
  balancePaise   Int       // Remaining spendable balance in paise
  purchasedById  String
  purchasedBy    User      @relation(fields: [purchasedById], references: [id])
  recipientEmail String
  expiresAt      DateTime  // Default: 365 days
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([codeHash])
  @@index([purchasedById])
}

model Coupon {
  id               String             @id @default(uuid())
  code             String             @unique // Uppercase: e.g. "AURAWELCOME"
  discountType     CouponDiscountType
  discountValue    Int                // Flat paise or percentage (e.g. 15 for 15%)
  maxDiscountPaise Int?               // Cap for percentage discounts
  minCartPaise     Int                @default(0)
  totalUsageLimit  Int?
  timesUsed        Int                @default(0)
  validFrom        DateTime
  validUntil       DateTime
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())

  @@index([code])
}

model SavedPaymentMethod {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String   // "CARD" or "UPI"
  provider         String   // "CASHFREE" or "PHONEPE"
  token            String   // Tokenized gateway reference
  maskedIdentifier String   // "•••• 4242" or "user@okhdfcbank"
  cardBrand        String?  // "VISA", "MASTERCARD", "RUPAY"
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String              // "ORDER_UPDATE", "SECURITY_ALERT", "PROMO"
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false)
  linkUrl   String?
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
}

model SupportTicket {
  id           String         @id @default(uuid())
  ticketNumber String         @unique // e.g. "TICK-20261110-001"
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?         @relation(fields: [orderId], references: [id])
  category     TicketCategory
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     String         @default("NORMAL")
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model StaffAuditLog {
  id             String   @id @default(uuid())
  staffUserId    String
  staffUser      User     @relation("StaffAudits", fields: [staffUserId], references: [id])
  action         String   // "VIEW_CUSTOMER_PII", "APPROVE_CLAIM", etc.
  targetEntity   String   // "Order", "User", "WarrantyClaim"
  targetEntityId String
  ipAddress      String?
  timestamp      DateTime @default(now())

  @@index([staffUserId])
  @@index([targetEntity, targetEntityId])
}
