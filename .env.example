# ==============================================================================
# Aura Retail & Lifestyle - Environment Variables Configuration (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit real secrets or production credentials to git.

# ------------------------------------------------------------------------------
# 1. Runtime & Application Server
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database & Connection Pooling (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local Docker Postgres URL:
DATABASE_URL="postgresql://aura_dev:aura_dev_password@localhost:5432/aura_marketplace_dev?schema=public"

# ------------------------------------------------------------------------------
# 3. In-Memory Cache & Distributed Locks (Redis 7)
# ------------------------------------------------------------------------------
# Local Docker Redis URL:
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. Cryptographic Security Keys
# ------------------------------------------------------------------------------
# JWT Secret (Minimum 32 characters long):
JWT_SECRET="aura_dev_jwt_super_secret_key_minimum_32_characters_long_12345"

# AES-256-GCM Field-Level PII Encryption Key (Exact 32-byte hex string = 64 characters):
PII_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ------------------------------------------------------------------------------
# 5. Payment Gateway (Cashfree Payments - Primary)
# ------------------------------------------------------------------------------
# Mode: TEST | PROD
CASHFREE_MODE=TEST
CASHFREE_APP_ID="TEST_APP_ID_MOCK_SANDBOX"
CASHFREE_SECRET_KEY="TEST_SECRET_KEY_MOCK_SANDBOX"
CASHFREE_WEBHOOK_SECRET="TEST_WEBHOOK_SECRET_MOCK_SANDBOX"

# ------------------------------------------------------------------------------
# 6. Payment Gateway (PhonePe PG - Secondary Failover)
# ------------------------------------------------------------------------------
PHONEPE_MODE=UAT
PHONEPE_MERCHANT_ID="MOCK_MERCHANT_ID"
PHONEPE_SALT_KEY="MOCK_SALT_KEY"
PHONEPE_SALT_INDEX=1

# ------------------------------------------------------------------------------
# 7. 3PL Logistics & Fulfillment (Shiprocket API)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL="sandbox_logistics@auralifestyle.in"
SHIPROCKET_PASSWORD="mock_shiprocket_password"
SHIPROCKET_WEBHOOK_TOKEN="mock_shiprocket_webhook_token"

# ------------------------------------------------------------------------------
# 8. Messaging & OTP (MSG91 - WhatsApp Business & SMS)
# ------------------------------------------------------------------------------
MSG91_AUTH_KEY="mock_msg91_auth_key"
MSG91_OTP_TEMPLATE_ID="mock_otp_template_id"
MSG91_SENDER_ID="AURA"

# ------------------------------------------------------------------------------
# 9. Transactional Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_mock_api_key_test_sandbox"
EMAIL_FROM_ADDRESS="orders@auralifestyle.in"

# ------------------------------------------------------------------------------
# 10. Cloud Object Storage (Cloudflare R2 - S3-Compatible API)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="mock_r2_account_id"
R2_ACCESS_KEY_ID="mock_r2_access_key_id"
R2_SECRET_ACCESS_KEY="mock_r2_secret_access_key"
R2_BUCKET_NAME="aura-dev-media"
NEXT_PUBLIC_R2_PUBLIC_URL="https://media.auralifestyle.in"

# ------------------------------------------------------------------------------
# 11. AI Wellness Assistant (Google Gemini 1.5 Flash)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="mock_gemini_api_key_sandbox"

# ------------------------------------------------------------------------------
# 12. Monitoring & Error Tracking (Optional in Local Dev)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL="info"
